
$ kubectl create namespace development
namespace/development created

$ kubectl create namespace production
namespace/production created

$ kubectl create quota dev-quota --hard=limits.memory=1Gi,requests.memory=896Mi,limits.cpu=1000m,requests.cpu=500m,pods=2 --namespace development
resourcequota/dev-quota created

$ kubectl describe quota dev-quota --namespace development
Name:            dev-quota
Namespace:       development
Resource         Used  Hard
--------         ----  ----
limits.cpu       0     1
limits.memory    0     1Gi
pods             0     2
requests.cpu     0     500m
requests.memory  0     896Mi

$ kubectl apply -f nginx-dev.yaml
pod/nginx created

$ kubectl describe quota dev-quota --namespace development
Name:            dev-quota
Namespace:       development
Resource         Used   Hard
--------         ----   ----
limits.cpu       500m   1
limits.memory    512Mi  1Gi
pods             1      2
requests.cpu     250m   500m
requests.memory  128Mi  896Mi

$ kubectl apply -f nginx2-troppa-memoria.yaml || true
Error from server (Forbidden): error when creating "nginx2-troppa-memoria.yaml": pods "nginx2" is forbidden: exceeded quota: dev-quota, requested: limits.memory=640Mi, used: limits.memory=512Mi, limited: limits.memory=1Gi

$ kubectl create -f ./default-development.yaml --namespace=development
limitrange/default-development created

$ kubectl describe limits default-development --namespace development
Name:       default-development
Namespace:  development
Type        Resource  Min  Max  Default Request  Default Limit  Max Limit/Request Ratio
----        --------  ---  ---  ---------------  -------------  -----------------------
Container   memory    -    -    128Mi            256Mi          -
Container   cpu       -    -    250m             250m           -

$ kubectl run nginx2 --image=nginx:1.29 --namespace development
pod/nginx2 created

$ kubectl get pod nginx2 --namespace development -o jsonpath='{.spec.containers[0].resources}'; echo
{"limits":{"cpu":"250m","memory":"256Mi"},"requests":{"cpu":"250m","memory":"128Mi"}}

$ kubectl describe quota dev-quota --namespace development
Name:            dev-quota
Namespace:       development
Resource         Used   Hard
--------         ----   ----
limits.cpu       750m   1
limits.memory    768Mi  1Gi
pods             2      2
requests.cpu     500m   500m
requests.memory  256Mi  896Mi

$ kubectl run nginx3 --image=nginx:1.29 --namespace development || true
Error from server (Forbidden): pods "nginx3" is forbidden: exceeded quota: dev-quota, requested: pods=1,requests.cpu=250m, used: pods=2,requests.cpu=500m, limited: pods=2,requests.cpu=500m

$ kubectl delete namespace development production
namespace "development" deleted
namespace "production" deleted
