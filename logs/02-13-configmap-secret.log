
$ kubectl create configmap my-config --from-literal=mykey1=myvalue1 --from-literal=mykey2=myvalue2
configmap/my-config created

$ kubectl get configmap my-config -o yaml
apiVersion: v1
data:
  mykey1: myvalue1
  mykey2: myvalue2
kind: ConfigMap
metadata:
  creationTimestamp: "2026-11-24T01:08:36Z"
  name: my-config
  namespace: default
  resourceVersion: "1966"
  uid: 626cfc79-0443-4779-97da-a543ad95a188

$ kubectl apply -f test-pod-configmap.yaml
pod/test-pod-configmap created

$ kubectl wait --for=jsonpath={.status.phase}=Succeeded pod/test-pod-configmap --timeout=120s
pod/test-pod-configmap condition met

$ kubectl logs test-pod-configmap | grep -E '^(HOME|HOSTNAME|mykey)'
HOME=/root
HOSTNAME=test-pod-configmap
mykey1=myvalue1
mykey2=myvalue2

$ kubectl create secret generic my-secret --from-literal user=admin --from-literal password=1234
secret/my-secret created

$ kubectl get secret my-secret -o yaml
apiVersion: v1
data:
  password: MTIzNA==
  user: YWRtaW4=
kind: Secret
metadata:
  creationTimestamp: "2026-11-24T01:08:38Z"
  name: my-secret
  namespace: default
  resourceVersion: "1985"
  uid: 9a83b3fa-1fe0-4d93-87a6-f9bc5f028245
type: Opaque

$ kubectl get secret my-secret -o jsonpath='{.data.password}' | base64 --decode; echo
1234

$ kubectl apply -f test-pod-secret.yaml
pod/test-pod-secret created

$ kubectl wait --for=jsonpath={.status.phase}=Succeeded pod/test-pod-secret --timeout=120s
pod/test-pod-secret condition met

$ kubectl logs test-pod-secret | grep -E '^(HOME|user|password)'
HOME=/root
password=1234
user=admin

$ kubectl apply -f test-pod-secret-volume.yaml
pod/test-pod-secret-volume created

$ kubectl wait --for=jsonpath={.status.phase}=Succeeded pod/test-pod-secret-volume --timeout=120s
pod/test-pod-secret-volume condition met

$ kubectl logs test-pod-secret-volume
total 0
lrwxrwxrwx    1 root     root            15 Nov 24 01:08 password -> ..data/password
lrwxrwxrwx    1 root     root            11 Nov 24 01:08 user -> ..data/user

admin

$ kubectl delete pod test-pod-configmap test-pod-secret test-pod-secret-volume
pod "test-pod-configmap" deleted from default namespace
pod "test-pod-secret" deleted from default namespace
pod "test-pod-secret-volume" deleted from default namespace

$ kubectl delete configmap my-config
configmap "my-config" deleted from default namespace

$ kubectl delete secret my-secret
secret "my-secret" deleted from default namespace
