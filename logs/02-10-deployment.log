
$ kubectl create deployment test-deploy-1 --image=nginx:1.29 --image=debian:13 --dry-run=client --output yaml > /tmp/test-deploy-1-generato.yml

$ cat /tmp/test-deploy-1-generato.yml
apiVersion: apps/v1
kind: Deployment
metadata:
  labels:
    app: test-deploy-1
  name: test-deploy-1
spec:
  replicas: 1
  selector:
    matchLabels:
      app: test-deploy-1
  strategy: {}
  template:
    metadata:
      labels:
        app: test-deploy-1
    spec:
      containers:
      - image: nginx:1.29
        name: nginx
        resources: {}
      - image: debian:13
        name: debian
        resources: {}
status: {}

